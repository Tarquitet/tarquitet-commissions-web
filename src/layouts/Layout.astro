---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
	title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="es" class="bg-brand-black text-brand-light selection:bg-brand-red selection:text-white">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content="Tarquitet - Comisiones y Portafolio" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/tarquitet-commissions/public/favicon.svg" />
    	<link rel="apple-touch-icon" sizes="180x180" href="/tarquitet-commissions/public/favicon.png" />
		<link rel="shortcut icon" href="/tarquitet-commissions/public/favicon.ico" />
		<title>{title}</title>
	</head>
	<body class="min-h-screen flex flex-col font-sans antialiased overflow-x-hidden pt-20">
		<Header />
		
		<main class="flex-grow">
			<slot />
		</main>

		<Footer />
	</body>
</html>