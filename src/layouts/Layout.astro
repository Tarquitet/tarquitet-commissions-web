---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
    title: string;
    description?: string;
    image?: string;
}

const { 
    title, 
    description = "Tarquitet - Professional Illustrator, Programmer & Designer. Digital Art Commissions and Gallery.",
    image = "/favicon/social-preview.jpg" 
} = Astro.props;

// 1. DEFINIR LA URL BASE (Evita errores de URL inválida en local)
const siteURL = Astro.site ? Astro.site.href : "https://art.tarquitet.com";

// 2. DEFINIR LA VARIABLE QUE FALTABA
const canonicalURL = new URL(Astro.url.pathname, siteURL);

// 3. GENERAR LA URL COMPLETA PARA LA IMAGEN DE PREVISUALIZACIÓN
const socialImageURL = new URL(image, siteURL);
---

<!doctype html>
<html lang="en" class="bg-brand-black text-brand-light selection:bg-brand-red selection:text-white">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <meta name="generator" content={Astro.generator} />

        <title>{title} | Tarquitet</title>
        <meta name="title" content={`${title} | Tarquitet`} />
        <meta name="description" content={description} />
        
        <link rel="canonical" href={canonicalURL} />
        
        <meta name="keywords" content="Multimedia Engineer, Digital Artist, Character Design, Programmer, Tarquitet, Colombia, Web Development" />
        <meta name="author" content="David Josué Pinto Gómez (Tarquitet)" />

        <meta property="og:type" content="website" />
        <meta property="og:url" content={canonicalURL} />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:image" content={socialImageURL} />

        <meta property="twitter:card" content="summary_large_image" />
        <meta property="twitter:url" content={canonicalURL} />
        <meta property="twitter:title" content={title} />
        <meta property="twitter:description" content={description} />
        <meta property="twitter:image" content={socialImageURL} />

        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;700;900&family=JetBrains+Mono:wght@400;700&display=swap" rel="stylesheet">
    </head>
    <body class="min-h-screen flex flex-col font-sans antialiased overflow-x-hidden">
        <Header />

        <main class="grow">
            <slot />
        </main>
        
        <Footer />
        
        <script>
            document.addEventListener('DOMContentLoaded', () => {
                const observerOptions = {
                    root: null,
                    rootMargin: '0px',
                    threshold: 0.15 // El elemento aparece cuando el 15% entra en pantalla
                };

                const observer = new IntersectionObserver((entries, observer) => {
                    entries.forEach(entry => {
                        if (entry.isIntersecting) {
                            entry.target.classList.add('is-visible');
                            observer.unobserve(entry.target); // Solo anima la primera vez que bajas
                        }
                    });
                }, observerOptions);

                // Busca todo lo que tenga la clase y lo vigila
                document.querySelectorAll('.reveal-on-scroll').forEach((el) => {
                    observer.observe(el);
                });
            });
        </script>
    </body>
</html>