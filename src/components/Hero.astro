---
import HeroPipeline from '../components/HeroPipeline.tsx';
---

<section id="about" class="relative min-h-screen flex items-center px-4 sm:px-6 lg:px-8 overflow-hidden reveal-on-scroll">
  {/* Fondo de luces rojas dinámicas */}
  
  <div class="absolute top-1/2 left-1/4 -translate-y-1/2 w-[500px] h-[500px] bg-brand-red/10 rounded-full blur-[120px] pointer-events-none"></div>

  <div class="relative z-10 max-w-7xl mx-auto w-full grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
    
    {/* COLUMNA IZQUIERDA: Textos y Botones (Queda igual) */}
    <div class="flex flex-col gap-6 text-center lg:text-left items-center lg:items-start">
      
      <div class="flex flex-col items-center lg:items-start gap-2">
        <h1 class="relative group cursor-default">
          <div class="signature-container inline-block">
            <img 
              src="/signature.png" 
              alt="Tarquitet Signature" 
              class="h-36 md:h-48 lg:h-60 w-auto object-contain signature-glow transition-transform duration-500 group-hover:scale-[1.03]"
            />
          </div>
          <span class="sr-only">TARQUITET</span>
        </h1>

        <h2 class="relative -mt-4 lg:-mt-10 ml-0 lg:ml-60 opacity-0 animate-fade-in-up z-20">
          <img 
            src="/tagline.png" 
            alt="Digital Illustrator" 
            class="h-10 md:h-12 w-auto object-contain opacity-80"
          />
          <span class="sr-only tracking-[0.3em]">DIGITAL ILLUSTRATOR</span>
        </h2>
      </div>

      <p class="text-brand-light/70 text-lg leading-relaxed max-w-lg">
        I bring your ideas to life through high-quality character design and digital illustration. Whether you have a clear concept or just a spark of imagination, I will transform your vision into striking artwork.
      </p>

      <div class="flex flex-wrap gap-4 mt-8 justify-center lg:justify-start items-center">
        {/* EL BOTÓN GIGANTE PRINCIPAL */}
        <a href="https://forms.gle/QLrFdUaHsva3t8Dg8" target="_blank" class="relative group px-10 py-4 bg-brand-red text-white font-black text-sm tracking-[0.2em] uppercase transition-all hover:scale-105 hover:shadow-[0_0_30px_rgba(220,38,38,0.6)]">
          <span class="relative z-10 flex items-center gap-2">
            Request Commission
          </span>
          {/* Efecto de borde glitch on hover */}
          <div class="absolute inset-0 border border-white/50 scale-105 opacity-0 group-hover:scale-100 group-hover:opacity-100 transition-all duration-300"></div>
        </a>

        {/* Botones secundarios más sutiles */}
        <a href="#portfolio" class="px-6 py-4 bg-transparent border-b-2 border-brand-gray/50 text-brand-light/60 font-bold text-xs tracking-widest uppercase hover:border-brand-red hover:text-white transition-all reveal-on-scroll">
          Gallery
        </a>
        <a href="#pricing" class="px-6 py-4 bg-transparent border-b-2 border-brand-gray/50 text-brand-light/60 font-bold text-xs tracking-widest uppercase hover:border-brand-red hover:text-white transition-all reveal-on-scroll">
          Pricing
        </a>
      </div>
    </div>

    {/* COLUMNA DERECHA: Animación del Pipeline (Reemplaza la foto estática) */}
    <div class="relative flex justify-center lg:justify-end">
      {/* Mantenemos tu efecto de luz roja de fondo */}
      <div class="absolute inset-0 bg-brand-red/5 blur-[80px] rounded-full scale-75 pointer-events-none"></div>
      
      {/* Aquí inyectamos el nuevo componente React */}
      <div class="relative z-10 w-full max-w-md lg:max-w-lg">
         <div class="hidden md:block">
            <HeroPipeline client:load/>
          </div>
      </div>
    </div>

  </div>
</section>

<style>
  /* 1. EFECTO DE ESCRITURA (Revelado de izquierda a derecha) */
  .signature-container {
    clip-path: inset(0 100% 0 0); /* Esconde toda la imagen al inicio */
    animation: write-reveal 1.2s cubic-bezier(0.2, 0.8, 0.2, 1) 0.5s forwards; /* Duración 1.2s, empieza a los 0.5s */
  }

  @keyframes write-reveal {
    0% { clip-path: inset(0 100% 0 0); }
    100% { clip-path: inset(0 0 0 0); } /* Revela la imagen completa */
  }

  /* 2. EFECTO NEÓN ROJO QUE RESPIRA */
  .signature-glow {
    filter: drop-shadow(0px 0px 0px rgba(220, 38, 38, 0));
    /* El brillo empieza DESPUÉS de que se termine de "escribir" (1.8s delay) */
    animation: red-pulse 3s infinite alternate 1.8s; 
  }

  @keyframes red-pulse {
    0% { filter: drop-shadow(0px 0px 5px rgba(220, 38, 38, 0.2)); }
    100% { filter: drop-shadow(0px 0px 25px rgba(220, 38, 38, 0.8)); }
  }

  /* 3. FADE IN PARA EL SUBTÍTULO (DIGITAL ILLUSTRATOR) */
  .animate-fade-in-up {
    animation: fadeInUp 0.8s ease-out 1.5s forwards; /* Aparece justo cuando la firma termina de escribirse */
  }

  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>