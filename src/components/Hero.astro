---
---
<section id="about" class="relative min-h-[85vh] flex items-center pt-24 px-4 sm:px-6 lg:px-8 overflow-hidden">
  
  <div class="absolute top-1/2 left-1/4 -translate-y-1/2 w-[500px] h-[500px] bg-brand-red/10 rounded-full blur-[120px] pointer-events-none"></div>

  <div class="relative z-10 max-w-7xl mx-auto w-full grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
    
    <div class="flex flex-col gap-6 text-center lg:text-left items-center lg:items-start">
      
      <div class="flex flex-col">
        <h1 class="text-6xl md:text-8xl font-black text-brand-red tracking-tighter drop-shadow-sm">
          TARQUITET
        </h1>
        <h2 class="text-xl md:text-2xl font-bold text-brand-light tracking-[0.3em] mt-[-10px] opacity-90">
          ILUSTRADOR DIGITAL
        </h2>
      </div>

      <p class="text-brand-light/70 text-lg leading-relaxed max-w-lg">
        Interesado en el diseño de personajes, arte conceptual y retarme con nuevas ideas. Combino técnicas de arte realista, anime, cartoon en el entorno digital.
      </p>

      <div class="flex flex-wrap gap-4 mt-4 justify-center lg:justify-start">
        <a href="#portfolio" class="px-8 py-3 bg-brand-red text-black font-bold text-xs tracking-widest rounded-lg uppercase transition-all hover:shadow-[0_0_20px_rgba(220,38,38,0.4)]">
          Portafolio
        </a>
        <a href="#pricing" class="px-8 py-3 bg-brand-gray/20 border border-brand-gray/50 text-brand-light/60 font-bold text-xs tracking-widest rounded-lg uppercase hover:border-brand-red/50 hover:text-brand-light transition-all">
          Precios
        </a>
        <a href="#tos" class="px-8 py-3 bg-brand-gray/20 border border-brand-gray/50 text-brand-light/60 font-bold text-xs tracking-widest rounded-lg uppercase hover:border-brand-red/50 hover:text-brand-light transition-all">
          T.O.S
        </a>
      </div>
    </div>

    <div class="relative flex justify-center lg:justify-end">
      <div class="absolute inset-0 bg-brand-red/5 blur-[80px] rounded-full scale-75"></div>
      <img 
        src="profile/profile.jpg" 
        alt="Personaje Zorro de Tarquitet" 
        class="relative z-10 w-full max-w-md lg:max-w-lg object-contain drop-shadow-[0_20px_50px_rgba(0,0,0,0.5)]"
      />
    </div>

  </div>
</section>