---
import rawTOS from '../data/tos.md?raw';

// 1. Separamos por secciones (##)
const sections = rawTOS.split('## ').slice(1);

const accordionData = sections.map(section => {
  const lines = section.split('\n');
  const title = lines[0].trim();
  const bodyLines = lines.slice(1);

  let htmlContent = '';
  let inCodeBlock = false;
  let codeBuffer = [];

  bodyLines.forEach(line => {
    const trimmedLine = line.trim();

    // Detección de bloques de código (Jerarquía de carpetas)
    if (trimmedLine.startsWith('```')) {
      if (!inCodeBlock) {
        inCodeBlock = true;
      } else {
        inCodeBlock = false;
        htmlContent += `<pre class="bg-black/60 p-5 rounded-lg border border-brand-red/20 text-brand-red font-mono text-[11px] my-6 leading-tight overflow-x-auto shadow-inner">${codeBuffer.join('\n')}</pre>`;
        codeBuffer = [];
      }
      return;
    }

    if (inCodeBlock) {
      codeBuffer.push(line); // Preservamos espacios originales dentro del código
      return;
    }

    if (!trimmedLine) return; // Ignorar líneas vacías

    // Procesar enumeradores (Dashes '-' o Asteriscos '*')
    if (trimmedLine.startsWith('-') || trimmedLine.startsWith('*')) {
      const cleanText = trimmedLine
        .replace(/^[\-\*]\s*/, '')
        .replace(/\*\*(.*?)\*\*/g, '<strong class="text-brand-red font-black">$1</strong>');
      
      htmlContent += `
        <div class="flex gap-4 mb-4 items-start group/line">
          <span class="text-brand-red font-black mt-0.5 opacity-50 group-hover/line:opacity-100 transition-opacity">/</span>
          <p class="text-brand-light/80 leading-snug italic">${cleanText}</p>
        </div>`;
    } 
    // Procesar párrafos normales o separadores
    else if (trimmedLine === '---') {
      htmlContent += `<div class="h-px bg-brand-red/10 my-8 shadow-[0_0_10px_rgba(220,38,38,0.1)]"></div>`;
    } 
    else {
      const cleanText = trimmedLine.replace(/\*\*(.*?)\*\*/g, '<strong class="text-brand-red font-black">$1</strong>');
      htmlContent += `<p class="mb-6 text-brand-light/70 italic leading-relaxed">${cleanText}</p>`;
    }
  });

  return { title, htmlContent };
});
---

<div class="max-w-4xl mx-auto pb-32 px-4 md:px-0">
  
  <header class="mb-16">
    <div class="border-l-8 border-brand-red pl-8 mb-10">
      <h2 class="text-brand-red font-black tracking-tighter text-6xl uppercase italic leading-[0.8] drop-shadow-[0_0_15px_rgba(220,38,38,0.2)]">
        SOBRE LA COMISIÓN FINALIZADA
      </h2>
    </div>
    
    <div class="space-y-6 text-brand-light/90 italic text-lg border-b border-brand-red/10 pb-12">
      <p>Primero que nada, gracias por apoyarme con esta comisión. Sigo aprendiendo continuamente para mejorar, y espero sinceramente que te guste mi trabajo. (^o^)/</p>

      <div class="bg-brand-red/5 border border-brand-red/20 p-8 rounded-2xl">
        <h4 class="text-brand-red font-black tracking-widest uppercase text-xs mb-4">AVISOS IMPORTANTES!!!</h4>
        <ul class="space-y-4 text-sm not-italic">
          <li class="flex gap-4 items-start">
            <span class="bg-brand-red text-black text-[10px] font-black px-1 mt-1">1-</span>
            <p><strong class="text-brand-red">¡El usuario está pagando por el resultado final de la imagen, no por otras cosas!</strong></p>
          </li>
          <li class="flex gap-4 items-start">
            <span class="bg-brand-red text-black text-[10px] font-black px-1 mt-1">2-</span>
            <p>Aquí hay una serie de advertencias e instrucciones después de entregar la versión final de la comisión</p>
          </li>
        </ul>
      </div>
    </div>
  </header>

  <div class="grid gap-4">
    {accordionData.map((item, index) => (
      <details class="group bg-[#050000] border border-brand-red/10 rounded-xl overflow-hidden transition-all duration-500 open:border-brand-red/40 open:bg-[#080000] open:shadow-[0_0_50px_rgba(220,38,38,0.05)]">
        <summary class="flex justify-between items-center p-6 cursor-pointer list-none select-none hover:bg-brand-red/5 transition-all">
          <div class="flex items-center gap-6">
            <span class="text-brand-red/20 font-mono text-xs font-bold">[{index + 1}]</span>
            <span class="text-brand-light font-black tracking-widest uppercase italic group-open:text-brand-red transition-colors duration-500">
              {item.title}
            </span>
          </div>
          <div class="text-brand-red/40 group-open:text-brand-red group-open:rotate-180 transition-all duration-500">
            <svg xmlns="[http://www.w3.org/2000/svg](http://www.w3.org/2000/svg)" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
          </div>
        </summary>
        
        <div class="px-12 pb-10 border-t border-brand-red/5 pt-8 shadow-inner">
          <div class="text-sm space-y-1" set:html={item.htmlContent}></div>
        </div>
      </details>
    ))}
  </div>

  <footer class="mt-20 p-12 border border-dashed border-brand-red/10 rounded-[3rem] text-center">
    <p class="text-brand-red text-[11px] font-black tracking-[0.4em] uppercase opacity-60">
        INFORMACIÓN Y ADVERTENCIAS - ÚLTIMA MODIFICACIÓN 29 MAYO, 2024
    </p>
  </footer>
</div>

<style>
  summary::-webkit-details-marker { display: none; }
  
  :global(pre) {
    white-space: pre !important;
    word-wrap: normal !important;
    font-family: 'Courier New', Courier, monospace;
    overflow-x: auto;
  }
</style>