---
// src/components/Header.astro
import Menu from './Menu.astro';
---

<header class="fixed top-0 left-0 w-full z-50 bg-[#050000] border-b border-brand-red shadow-[0_4px_20px_rgba(220,38,38,0.15)] backdrop-blur-md">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex justify-between items-center h-20">
      
      <a href="/" class="relative overflow-hidden group">
        <span class="text-3xl font-black tracking-tighter bg-linear-to-r from-brand-red via-[#ff4d4d] to-brand-red bg-[length:200%_auto] bg-clip-text text-transparent animate-shimmer">
          TARQUITET
        </span>
      </a>

      <nav class="hidden md:flex gap-8 items-center">
        <Menu />
      </nav>

      <button id="mobile-menu-btn" class="md:hidden text-brand-red hover:text-white focus:outline-none transition-colors p-2">
        <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
      </button>

    </div>
  </div>

  <div id="mobile-menu-panel" class="hidden md:hidden bg-[#050000] border-t border-brand-red/20 absolute w-full shadow-2xl">
    <nav class="flex flex-col items-center gap-6 py-8">
      <Menu />
    </nav>
  </div>
</header>

<style>
  @keyframes shimmer {
    0% { background-position: -200% center; }
    100% { background-position: 200% center; }
  }
  .animate-shimmer {
    animation: shimmer 4s linear infinite;
  }
</style>

<script>
  // Lógica para abrir/cerrar el menú en celular
  const btn = document.getElementById('mobile-menu-btn');
  const panel = document.getElementById('mobile-menu-panel');
  
  btn?.addEventListener('click', () => {
    panel?.classList.toggle('hidden');
  });

  // Cerrar el menú automáticamente al hacer clic en un enlace
  const mobileLinks = panel?.querySelectorAll('a');
  mobileLinks?.forEach(link => {
    link.addEventListener('click', () => {
      panel?.classList.add('hidden');
    });
  });
</script>