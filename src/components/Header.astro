---
import Menu from './Menu.astro';
---

{/* Cambiamos el opacity-100 por opacity-0 y agregamos el translate para esconderlo al inicio */}
<header id="main-header" class="fixed top-0 left-0 w-full z-50 bg-[#050000]/90 border-b border-brand-red/30 shadow-[0_4px_20px_rgba(0,0,0,0.5)] backdrop-blur-md transition-all duration-500 opacity-0 -translate-y-full">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex justify-between items-center h-20">
      
      <a href="/#about" class="relative overflow-hidden group flex items-center justify-center">
        <img 
          src="/signature.png" 
          alt="Tarquitet Signature" 
          class="h-12 w-auto object-contain transition-all duration-300 group-hover:scale-105"
        />
        <span class="sr-only">TARQUITET</span>
      </a>

      {/* Nav Desktop - Con espacio para los submenús */}
      <nav class="hidden md:flex gap-10 items-center h-full">
        <Menu />
      </nav>

      <button id="mobile-menu-btn" aria-label="Open mobile menu" class="md:hidden text-brand-red hover:text-white focus:outline-none transition-colors p-2">
        <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
      </button>

    </div>
  </div>

  {/* Panel Móvil */}
  <div id="mobile-menu-panel" class="hidden md:hidden bg-[#050000]/95 border-t border-brand-red/20 absolute w-full shadow-2xl h-screen overflow-y-auto">
    <nav class="flex flex-col items-center gap-2 py-10">
      <Menu />
    </nav>
  </div>
</header>

<style>
  @keyframes shimmer {
    0% { background-position: -200% center; }
    100% { background-position: 200% center; }
  }
  .animate-shimmer {
    animation: shimmer 4s linear infinite;
  }
</style>

<script>
  // --- LÓGICA DEL MENÚ MÓVIL (Tuya) ---
  const btn = document.getElementById('mobile-menu-btn');
  const panel = document.getElementById('mobile-menu-panel');
  
  btn?.addEventListener('click', () => {
    panel?.classList.toggle('hidden');
    document.body.classList.toggle('overflow-hidden');
  });

  const mobileLinks = panel?.querySelectorAll('a');
  mobileLinks?.forEach(link => {
    link.addEventListener('click', () => {
      panel?.classList.add('hidden');
      document.body.classList.remove('overflow-hidden');
    });
  });

  // --- NUEVA LÓGICA: MOSTRAR HEADER AL HACER SCROLL ---
  const header = document.getElementById('main-header');
  
  window.addEventListener('scroll', () => {
    // Si el usuario baja más de 100px (sale del inicio del Hero), mostramos el menú
    if (window.scrollY > 100) {
      header?.classList.remove('opacity-0', '-translate-y-full');
      header?.classList.add('opacity-100', 'translate-y-0');
    } else {
      // Si sube al inicio del todo, lo volvems a esconder
      header?.classList.add('opacity-0', '-translate-y-full');
      header?.classList.remove('opacity-100', 'translate-y-0');
      
      // Aseguramos que si suben rápido, se cierre el panel móvil si estaba abierto
      if(panel && !panel.classList.contains('hidden')){
          panel.classList.add('hidden');
          document.body.classList.remove('overflow-hidden');
      }
    }
  });
</script>