---
import type { ArtPiece } from '../data/gallery';

interface Props {
  art: ArtPiece;
}

const { art } = Astro.props;
---

<div class="group relative aspect-[4/5] overflow-hidden rounded-xl border border-brand-red/20 bg-[#050000] shadow-[0_0_25px_rgba(0,0,0,1)] transition-all duration-500 hover:border-brand-red/60">
  
  {/* Fecha flotante (Top Right) */}
  <div class="absolute top-4 right-4 z-20 opacity-0 group-hover:opacity-100 transition-opacity duration-500">
    <span class="bg-brand-red text-black px-3 py-1 text-[10px] font-black tracking-widest rounded-sm shadow-[0_0_10px_rgba(220,38,38,0.5)]">
      {art.date}
    </span>
  </div>

  <img 
    src={`/portfolio/${art.filename}`} 
    alt={art.title} 
    class="h-full w-full object-cover transition-transform duration-1000 group-hover:scale-105"
    loading="lazy"
  />

  <div class="absolute inset-0 bg-linear-to-t from-[#050000] via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500 flex flex-col justify-end p-8">
    <div class="translate-y-4 group-hover:translate-y-0 transition-all duration-500">
      <div class="flex items-center gap-3">
        <span class="text-brand-red text-[10px] font-black tracking-[0.5em] uppercase italic opacity-70">
          {art.category}
        </span>
      </div>
      
      <h4 class="text-brand-red font-black text-2xl tracking-tighter uppercase mt-1 drop-shadow-[0_0_12px_rgba(220,38,38,0.6)]">
        {art.title}
      </h4>
      
      <div class="mt-4 h-0.5 w-12 bg-brand-red shadow-[0_0_15px_rgba(220,38,38,1)]"></div>
    </div>
  </div>
</div>