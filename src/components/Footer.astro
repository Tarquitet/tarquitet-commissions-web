---
import { artisticNetworks } from '../data/socials';
import type { SocialNetwork } from '../data/socials';
---

<footer id="contact" class="w-full bg-black border-t-2 border-brand-red pt-8 pb-6 relative">
  <div class="max-w-7xl mx-auto px-4">
    
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 text-center items-center mb-10">
      
      <div class="flex flex-col md:items-start items-center gap-2">
        <span class="text-[10px] font-black text-brand-red uppercase tracking-[0.2em]">Discord</span>
        <div class="flex items-center gap-2 group cursor-pointer copy-trigger" data-copy="tarquitet">
          <span class="text-white group-hover:text-brand-red transition-colors text-xl font-black italic uppercase copy-text">
            @tarquitet
          </span>
          <svg class="w-4 h-4 text-white group-hover:text-brand-red" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"></path></svg>
        </div>
      </div>

      <div class="flex flex-col items-center gap-3">
        <span class="text-[10px] font-black text-brand-red uppercase tracking-[0.2em]">Redes</span>
        <div class="flex gap-6 items-center">
          {artisticNetworks.map((network: SocialNetwork) => (
            <a 
              href={network.url} 
              target="_blank" 
              rel="noopener noreferrer" 
              title={network.name}
              class="w-6 h-6 bg-white hover:bg-brand-red transition-all duration-300"
              style={`
                mask-image: url(/icons/${network.icon}); 
                mask-repeat: no-repeat; 
                mask-position: center; 
                mask-size: contain; 
                -webkit-mask-image: url(/icons/${network.icon}); 
                -webkit-mask-repeat: no-repeat; 
                -webkit-mask-position: center; 
                -webkit-mask-size: contain;
              `}
            >
            </a>
          ))}
        </div>
      </div>

      <div class="flex flex-col md:items-end items-center gap-2">
        <span class="text-[10px] font-black text-brand-red uppercase tracking-[0.2em]">Correo</span>
        <div class="flex items-center gap-2 group cursor-pointer copy-trigger" data-copy="contacto@tarquitet.com">
          <span class="text-white group-hover:text-brand-red transition-colors text-xl font-black italic uppercase copy-text">
            contact@tarquitet.com
          </span>
          <svg class="w-4 h-4 text-white group-hover:text-brand-red" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"></path></svg>
        </div>
      </div>

    </div>

    {/* LÍNEA FINAL COMPACTA */}
    <div class="border-t border-white/10 pt-6 flex flex-col md:flex-row justify-between items-center gap-4">
      <div class="text-[11px] font-black tracking-widest text-white uppercase italic">
        TARQUITET &copy; <span id="current-year" class="text-brand-red"></span>
      </div>
      <a href="https://tarquitet.com" target="_blank" class="text-white/40 hover:text-white font-mono text-[9px] uppercase tracking-[0.3em] transition-colors">
        Portafolio Profesional
      </a>
    </div>
    
  </div>

  <div id="copy-toast" class="fixed bottom-8 left-1/2 -translate-x-1/2 bg-white text-black px-8 py-3 rounded-lg font-black text-xs tracking-[0.2em] uppercase opacity-0 pointer-events-none transition-all duration-300 z-50 shadow-[0_0_30px_rgba(255,255,255,0.2)]">
    ¡Copiado!
  </div>
</footer>

<script>
  // Año dinámico
  const yearElement = document.getElementById('current-year');
  if (yearElement) {
    yearElement.textContent = new Date().getFullYear().toString();
  }

  // Lógica Copy mejorada
  const copyTriggers = document.querySelectorAll('.copy-trigger');
  const toast = document.getElementById('copy-toast');

  copyTriggers.forEach(trigger => {
    trigger.addEventListener('click', async () => {
      const textToCopy = trigger.getAttribute('data-copy') || '';
      const textSpan = trigger.querySelector('.copy-text') as HTMLElement | null;

      if (!textSpan || !textToCopy) return;

      const originalText = textSpan.innerText;

      try {
        await navigator.clipboard.writeText(textToCopy);
        
        textSpan.innerText = '¡COPIADO!';
        textSpan.classList.add('text-green-500');

        if (toast) {
          toast.classList.remove('opacity-0', 'translate-y-4');
          toast.classList.add('opacity-100', 'translate-y-0');
        }

        setTimeout(() => {
          textSpan.innerText = originalText;
          textSpan.classList.remove('text-green-500');
          if (toast) {
            toast.classList.remove('opacity-100', 'translate-y-0');
            toast.classList.add('opacity-0', 'translate-y-4');
          }
        }, 1200);
      } catch (err) {
        console.error('Error al copiar:', err);
      }
    });
  });
</script>