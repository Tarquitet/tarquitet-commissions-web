---
import type { PricingItem } from '../data/pricing';

interface Props {
  item: PricingItem;
}

const { item } = Astro.props;
---

<div class="group relative bg-[#050000] border border-brand-red/10 rounded-2xl p-8 transition-all duration-500 hover:border-brand-red/50 hover:shadow-[0_0_40px_rgba(220,38,38,0.1)] flex flex-col justify-between overflow-hidden">
  
  <div class="absolute top-0 right-0 -translate-y-1/2 translate-x-1/2 w-32 h-32 bg-brand-red/5 rounded-full blur-[60px] group-hover:bg-brand-red/10 transition-colors"></div>

  <div>
    <div class="flex justify-between items-start mb-6">
      <span class="text-brand-red/40 font-mono text-[10px] tracking-widest uppercase">/ Clase_Precio</span>
      <span class="text-brand-red font-black text-3xl tracking-tighter drop-shadow-[0_0_10px_rgba(220,38,38,0.4)]">
        {item.price}
      </span>
    </div>

    <h4 class="text-brand-light font-black text-2xl uppercase italic tracking-tighter mb-2 group-hover:text-brand-red transition-colors">
      {item.category}
    </h4>
    
    <p class="text-brand-light/50 text-xs italic leading-relaxed mb-8 border-l border-brand-red/20 pl-4">
      {item.description}
    </p>

    <ul class="space-y-3">
      {item.features.map(feature => (
        <li class="flex items-center gap-3 text-[11px] font-bold text-brand-light/70 uppercase tracking-widest">
          <span class="w-1.5 h-1.5 bg-brand-red shadow-[0_0_8px_rgba(220,38,38,1)]"></span>
          {feature}
        </li>
      ))}
    </ul>
  </div>

  <div class="mt-10 pt-6 border-t border-brand-red/5">
    <button class="w-full py-3 bg-brand-red/5 border border-brand-red/20 text-brand-red text-[10px] font-black uppercase tracking-[0.3em] hover:bg-brand-red hover:text-black transition-all duration-500 rounded-lg">
      Verificar Disponibilidad
    </button>
  </div>
</div>