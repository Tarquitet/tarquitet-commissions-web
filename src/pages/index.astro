---
import Layout from '../layouts/Layout.astro';
import HeroSimple from '../components/HeroSimple.astro';
import ContentViewer from '../components/ContentViewer.tsx';
---

<Layout title="Tarquitet | Commissions">
  <!-- 1. Hero (Pantalla completa, sin scroll) -->
  <HeroSimple />
  
  <!-- 2. Contenido Principal (Navegación Izquierda/Derecha) -->
  <main id="main-content" class="w-screen min-h-screen py-20">
    <ContentViewer client:load />
  </main>
</Layout>