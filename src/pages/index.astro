---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import TOSSection from '../components/TOSSection.tsx';
import PortfolioGallery from '../components/PortfolioGallery.tsx';
import PricingSection from '../components/PricingSection.tsx';
import GuidelinesSection from '../components/GuidelinesSection';
---

<Layout title="Tarquitet | Comisiones de Arte">
    <Hero />

    <main class="space-y-40 pb-32">

        <section id="rules" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex flex-col mb-16 border-b border-brand-red/20 pb-6">
                <h3 class="text-brand-red font-black tracking-tighter text-4xl md:text-6xl uppercase italic break-words">WILL/WON'T DRAW</h3>
            </div>

            <GuidelinesSection client:load />
        </section>

        <section id="portfolio" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex flex-col mb-16 border-b border-brand-red/20 pb-6">
                    <h3 class="text-brand-red font-black tracking-tighter text-4xl md:text-6xl uppercase italic break-words">Portfolio</h3>
            </div>

            <PortfolioGallery client:load />
        </section>

        <section id="pricing" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex flex-col mb-16 border-b border-brand-red/20 pb-6">
                <h3 class="text-brand-red font-black tracking-tighter text-4xl md:text-6xl uppercase italic break-words">Pricing</h3>
            </div>
            
            <PricingSection client:load />
        </section>

        <section id="tos" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex flex-col mb-16 border-b border-brand-red/20 pb-6">
                <h3 class="text-brand-red font-black tracking-tighter text-4xl md:text-6xl uppercase italic break-words">Terms of Service</h3>
            </div>
            
            <TOSSection client:load />
        </section>
    </main>
</Layout>