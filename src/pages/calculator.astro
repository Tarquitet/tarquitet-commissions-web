---
import Layout from '../layouts/Layout.astro';
import CalculatorEngine from '../components/calculator/CalculatorEngine';
---

<Layout title="Calculadora de Comisiones | Tarquitet">
  <main class="min-h-screen pt-32 pb-20 bg-[#050000]">
    <div class="max-w-7xl mx-auto px-4">
      
      <header class="mb-12 border-b border-brand-red/20 pb-8">
        <h1 class="text-white font-black text-5xl md:text-7xl uppercase italic tracking-tighter">
          Calcula tu <span class="text-brand-red">Presupuesto</span>
        </h1>
        <p class="text-brand-light/40 font-mono text-sm uppercase tracking-[0.4em] mt-4">
          Ajusta tu precio para después solicitarlo al artista.
        </p>
      </header>

      <CalculatorEngine client:load />
      
    </div>
  </main>
</Layout>